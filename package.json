{
  "name": "sakhi-ai-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc && vite build && npm --prefix server run build",
    "preview": "vite preview",
    "setup": "npm install && npm --prefix server install && npm --prefix server run db:generate && npm --prefix server run db:push",
    "start": "electron . --dev",
    "electron:dev": "electron . --dev",
    "electron:start": "npm run build && electron ."
  },
  "dependencies": {
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.9",
    "@prisma/client": "^6.4.1",
    "@react-three/drei": "^9.106.0",
    "@react-three/fiber": "^8.16.8",
    "@shadergradient/react": "^2.4.20",
    "@types/three": "^0.185.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "ogl": "^1.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.185.1",
    "winston": "^3.19.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.4",
    "electron": "^31.0.0",
    "playwright": "^1.62.1",
    "prisma": "^6.4.1",
    "tsx": "^4.23.7",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
