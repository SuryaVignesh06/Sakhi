# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Local runtimes
# OLLAMA_URL=http://localhost:11434
# LMSTUDIO_URL=http://localhost:1234

# Pin a default instead of auto-resolving
# DEFAULT_PROVIDER=gemini
# DEFAULT_MODEL=gemini-2.5-flash
